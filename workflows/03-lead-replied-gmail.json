{
  "name": "03 · Lead replied → star + update sheet + Telegram",
  "nodes": [
    {
      "id": "91ce6658-67d7-459c-a682-547dfdf132f4",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ],
      "parameters": {
        "content": "## Lead replied → star + update sheet + Telegram\nPolls Gmail every 5 minutes. Bounces and out-of-office replies are ignored. A real reply is matched against the Leads sheet by email; when it is a lead, the thread is starred, the row's status becomes **Replied** (or **Do not contact** for an opt-out) and you get the reply text on Telegram.",
        "width": 640,
        "height": 240,
        "color": 5
      }
    },
    {
      "id": "3c530612-a4d6-4b44-a63c-11b36b140064",
      "name": "New inbox mail",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 5,
              "unit": "minutes"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "in:inbox -from:me -category:promotions -category:social"
        },
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_ME",
          "name": "Gmail"
        }
      }
    },
    {
      "id": "30892133-d1ca-435f-ab69-7f06eace473c",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0f214811-4198-442d-ad4d-29522174829c",
