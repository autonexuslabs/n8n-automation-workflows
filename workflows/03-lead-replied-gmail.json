    {
      "id": "b6ae67c6-889a-455f-a1be-3af3a95566b6",
      "name": "Classify reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Keep only real human replies, and flag opt-outs. Order matters:\n// \"I'll stop by\" is not an opt-out, \"no thanks\" is not a yes.\nconst out = []\nfor (const item of $('New inbox mail').all()) {\n  const m = item.json\n  const from = (m.from?.value?.[0]?.address ?? '').toLowerCase()\n  const subject = m.subject ?? ''\n  const auto = m.headers?.['auto-submitted'] ?? ''\n  if (/^(mailer-daemon|postmaster)@/.test(from)) continue\n  if ((auto && !/auto-submitted: no/i.test(auto)) || /out of (the )?office|automatic reply|auto-?reply/i.test(subject)) continue\n  const text = String(m.text ?? '').split(/\\n\\s*(on .{5,120} wrote:|-----\\s*original message)/i)[0].trim()\n  const optOut = /(^|\\n)\\s*(stop|unsubscribe|remove)\\s*[.!]?\\s*($|\\n)|\\b(unsubscribe me|remove me|take me off|stop (emailing|contacting))\\b/i.test(text)\n  out.push({ json: { email: from, subject, text: text.slice(0, 1500), messageId: m.id, threadId: m.threadId, optOut } })\n}\nreturn out"
      }
    },
    {
      "id": "a3b5a651-c895-40d9-a869-e8e08d733f53",
      "name": "Find lead by email",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ],
      "alwaysOutputData": false,
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $('Settings').first().json.sheetId }}",
          "mode": "id"
        },
        "sheetName": {
