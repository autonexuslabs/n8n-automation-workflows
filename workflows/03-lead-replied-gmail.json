              "lookupValue": "={{ $json.email }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets"
        }
      }
    },
    {
      "id": "fa669c3f-4d01-43ad-a021-4dc96b4a35a9",
      "name": "Merge reply + lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// Pair each found lead row with the reply it matched.\nconst replies = $('Classify reply').all().map((i) => i.json)\nreturn $input.all().map((row) => {\n  const r = replies.find((x) => x.email === String(row.json.email ?? '').toLowerCase())\n  return r ? { json: { ...r, name: row.json.name ?? r.email, status: r.optOut ? 'Do not contact' : 'Replied', lastReply: new Date().toISOString().slice(0, 10) } } : null\n}).filter(Boolean)"
      }
    },
    {
      "id": "1c205dab-aecd-4f6f-ad02-6ee64762f382",
