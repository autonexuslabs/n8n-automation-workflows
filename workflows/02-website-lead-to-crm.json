    {
      "id": "bf3fcc43-468e-40b4-aa40-a5cff7f9242b",
      "name": "Validate + normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// Clean what the website sent; never trust client input.\nconst b = $('Lead webhook').first().json.body ?? {}\nconst clean = (v, n = 300) => String(v ?? '').trim().slice(0, n)\nconst digits = clean(b.phone).replace(/\\D/g, '').slice(-10)\nconst message = clean(b.message, 2000)\nconst EMERGENCY = /\\b(gas (smell|leak)|smell(s|ing)? (of )?gas|carbon monoxide|co (alarm|detector)|smoke|sparks?|sparking|on fire)\\b/i\nreturn [{ json: {\n  receivedAt: new Date().toISOString(),\n  name: clean(b.name, 120),\n  phone: digits.length === 10 ? '(' + digits.slice(0, 3) + ') ' + digits.slice(3, 6) + '-' + digits.slice(6) : clean(b.phone, 40),\n  email: clean(b.email, 200).toLowerCase(),\n  message,\n  source: clean(b.source || 'website', 40),\n  emergency: EMERGENCY.test(message),\n  valid: Boolean(clean(b.name) && (digits.length === 10 || clean(b.email).includes('@'))),\n  status: 'New',\n} }]"
      }
    },
    {
      "id": "0f7beb90-e028-4143-aeff-ead225f77563",
